    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#1d0e03",
    "activityBarBadge.foreground": "#e7e7e7",
    "sash.hoverBorder": "#5e16c1",
    "statusBar.background": "#481193",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#5e16c1",
    "statusBarItem.remoteBackground": "#481193",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#481193",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#48119399",
    "titleBar.inactiveForeground": "#e7e7e799",
