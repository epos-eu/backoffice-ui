    "activityBarBadge.foreground": "#e7e7e7",
    "sash.hoverBorder": "#6a83da",
    "statusBar.background": "#4161d0",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#6a83da",
    "statusBarItem.remoteBackground": "#4161d0",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#4161d0",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#4161d099",
    "titleBar.inactiveForeground": "#e7e7e799",
